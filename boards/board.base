# Regenerated by docket. Projects are named explicitly; run
# "docket project add" to add one and rewrite these filters.
filters:
  and:
    - or:
      - file.inFolder("PIER")
    - 'note.status_category != "done"'
formulas:
  stage: 'if(note.status == "Discovery", "1. Discovery", if(note.status == "В работе", "2. В работе", if(note.status == "Business Review", "3. Business Review", if(note.status == "QA Stage", "4. QA Stage", if(note.status == "RFT Stage", "5. RFT Stage", if(note.status == "RF DEPLOYMENT", "6. RF DEPLOYMENT", if(note.status == "Готово", "7. Готово", if(note.status == "Отменено", "8. Отменено", ""))))))))'
properties:
  formula.stage:
    displayName: Stage
  note.title:
    displayName: Title
  note.assignee:
    displayName: Assignee
  note.priority:
    displayName: Priority
  note.tags:
    displayName: Tags
views:
  - type: cards
    name: Board
    groupBy:
      property: formula.stage
      direction: ASC
    order:
      - note.title
      - note.assignee
      - note.priority
      - note.labels
      - note.tags
