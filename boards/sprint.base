# Regenerated by docket. The sprint board exists because a task carries
# its sprint as a property: Bases can only filter on what the note itself says.
filters:
  and:
    - or:
      - file.inFolder("PIER")
    - 'note.sprint'
formulas:
  stage: 'if(note.status == "Discovery", "1. Discovery", if(note.status == "В работе", "2. В работе", if(note.status == "Business Review", "3. Business Review", if(note.status == "QA Stage", "4. QA Stage", if(note.status == "RFT Stage", "5. RFT Stage", if(note.status == "RF DEPLOYMENT", "6. RF DEPLOYMENT", if(note.status == "Готово", "7. Готово", if(note.status == "Отменено", "8. Отменено", ""))))))))'
properties:
  formula.stage:
    displayName: Stage
  note.sprint:
    displayName: Sprint
  note.title:
    displayName: Title
  note.estimate:
    displayName: Size
  note.assignee:
    displayName: Assignee
views:
  - type: cards
    name: Sprint
    groupBy:
      property: note.sprint
      direction: DESC
    order:
      - note.title
      - formula.stage
      - note.estimate
      - note.assignee
  - type: table
    name: By stage
    groupBy:
      property: formula.stage
      direction: ASC
    order:
      - note.key
      - note.title
      - note.sprint
      - note.estimate
      - note.assignee
